# Separate from the demo API. Never put credentials in VITE_* variables.
APP_ENV=development
DATABASE_URL=postgresql+psycopg://resolveai:CHANGE_ME@localhost:5432/resolveai
APP_ORIGINS=http://localhost:5173
ALLOW_SIGNUP=false
GEMINI_API_KEY=
# Choose a currently supported model for your provider account.
GEMINI_MODEL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/integrations/gmail/callback
# Generate privately with cryptography.fernet.Fernet.generate_key().
# Rotation: new key first, comma-separated previous keys retained for decryption.
OAUTH_ENCRYPTION_KEY=
ENABLE_EMAIL_SEND=false
